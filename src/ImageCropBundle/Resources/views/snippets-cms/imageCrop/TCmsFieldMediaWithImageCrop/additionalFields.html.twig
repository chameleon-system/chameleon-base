{# crop \ChameleonSystem\CoreBundle\MediaManager\LibraryDataModel\ImageCropDataModel #}
<input type="hidden" name="{{ fieldName }}_image_crop_id" id="{{ fieldName }}_image_crop_id" value="{{ crop.id }}">

<div class="row mt-2">
    <div class="col-12 col-lg-6 align-items-stretch d-flex flex-column justify-content-between">
        <div class="">
            <div id="label_{{ fieldName }}_image_crop_id" class="d-inline-block mb-2 py-1 px-2 border w-100">
                {{ 'chameleon_system_image_crop.field.selected_crop' | trans }}<br>
                <span class="fw-bold">{{ selectedCropLabel|default('-') }}</span>
            </div>
            <div>
                <a class="btn btn-sm btn-light mb-3" id="{{ fieldName }}_image_crop_id_reset_button"{% if not crop %} style="display: none;"{% endif %}
                   data-field-name="{{ fieldName }}"><i class="fas fa-unlink text-danger pe-2"></i>{{ 'chameleon_system_image_crop.field.reset_crop' | trans }}
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div id="{{ fieldName }}-saved-crops">
            <div id="{{ fieldName }}-saved-crops-list-container"{% if savedCrops|default([])|length < 1 %} class="d-none"{% endif %}>
                <p class="fw-bold mb-0">{{ 'chameleon_system_image_crop.field.crop_list_headline'|trans }}</p>
                <ul id="saved_crops_list_{{ fieldName }}" class="saved-crops-list p-0 ms-3 my-2">
                    {% if savedCrops|default([])|length > 0 %}
                        {% for savedCrop in savedCrops|default([]) %}
                            <li{% if savedCrop.selected %} class="active"{% endif %}>
                                <a href="#" data-crop-id="{{ savedCrop.id|e('html_attr') }}" data-field-name="{{ fieldName|e('html_attr') }}" data-image-id="{{ imageId|e('html_attr') }}">{{ savedCrop.name }}</a>
                            </li>
                        {% endfor %}
                    {% else %}
                        <li>-</li>
                    {% endif %}
                </ul>
            </div>

            <div>
                {{ buttonHtml | raw }}
            </div>
        </div>
    </div>
</div>

{% if crop %}
    <script type="text/javascript">
        (function ($, window) {
            $('#{{ fieldName }}_image_crop_id_reset_button').on('click', function (e) {
                window.imageCropResetButtonCallBack.call(this, e, '{{ crop.cmsMedia.id|e('js') }}');
            });
            $.ajax({
                type: "GET",
                async: true,
                data: {
                    imageId: '{{ crop.cmsMedia.id }}',
                    cropId: '{{ crop.id }}',
                    _fieldName: '{{ fieldName }}'
                },
                url: '{{ urlToGetImage | raw }}',
                success: function (jsonData) {
                    $('#cmsimagefielditem_imagediv_{{ fieldName }}0 img').attr('src', jsonData.imageUrl);
                    CloseModalIFrameDialog();
                },
                dataType: 'json'
            });
        })(jQuery, window);
    </script>
{% endif %}

<script type="text/javascript">
    (function ($, window) {
        window.returnUrlToGetCroppedImageForImageCropField = function () {
            return '{{ urlToGetImage | raw }}';
        };
        if ('function' === typeof window.refreshImageCropFieldDetails) {
            window.refreshImageCropFieldDetails('{{ fieldName|e('js') }}', '{{ imageId|e('js') }}');
        }
    })(jQuery, window);
</script>
