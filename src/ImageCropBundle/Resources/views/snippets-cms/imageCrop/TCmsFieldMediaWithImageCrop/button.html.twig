<a href="#" id="{{ fieldName }}-crop-button"
   class="btn btn-sm btn-secondary{% if not imageIsSet %} d-none{% endif %}"
   onclick="openImageCropEditor('{{ cropEditorUrl }}&{{ constant('\\ChameleonSystem\\ImageCropBundle\\Bridge\\Chameleon\\BackendModule\\ImageCropEditorModule::URL_PARAM_IMAGE_ID') }}='+$('#{{ fieldName }}').val()+'&{{ constant('\\ChameleonSystem\\ImageCropBundle\\Bridge\\Chameleon\\BackendModule\\ImageCropEditorModule::URL_PARAM_ENABLE_CALLBACK') }}=1&{{ constant('\\ChameleonSystem\\ImageCropBundle\\Bridge\\Chameleon\\BackendModule\\ImageCropEditorModule::URL_PARAM_FIELD_NAME') }}={{ fieldName }}&{{ constant('\\ChameleonSystem\\ImageCropBundle\\Bridge\\Chameleon\\BackendModule\\ImageCropEditorModule::URL_PARAM_CROP_ID') }}='+$('#{{ fieldName }}_image_crop_id').val()); return false;">
    <i class="fas fa-edit pe-2"></i> {{ 'chameleon_system_image_crop.field.edit_crop' | trans }}
</a>
