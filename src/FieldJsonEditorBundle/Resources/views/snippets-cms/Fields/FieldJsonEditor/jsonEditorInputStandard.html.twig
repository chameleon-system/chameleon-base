<div id="editor_holder"></div>
<input type="hidden" name="json_editor" id="json_editor_field">

<script>
    const jsonData = {{ jsonData|json_encode|raw }};

    window.addEventListener('DOMContentLoaded', () => {
        const hidden = document.getElementById('json_editor_field');

        const editor = new JSONEditor({
            id: "editor_holder",
            json: (jsonData && typeof jsonData === 'object') ? jsonData : {},
            when: {
                rendered: () => { hidden.value = editor.json; },
                updated: ()  => { hidden.value = editor.json; }
            }
        });

        hidden.value = editor.json;
    });
</script>
