{% set editorId = fieldName ~ '_editor' %}
{% set hiddenFieldId = fieldName ~ '_field' %}
<div class="card">
    <div class="card-header">
        JSON Editor
    </div>
    <div class="card-body pd-json-editor-wrapper bg-light">
        <div id="{{ editorId }}">

        </div>
        <input type="hidden" name="{{ fieldName }}" id="{{ hiddenFieldId }}">
    </div>
</div>
<script>
    const jsonData = {{ jsonData|json_encode|raw }};

    window.addEventListener('DOMContentLoaded', () => {
        const hidden = document.getElementById('{{ hiddenFieldId|e('js') }}');
        const editorRoot = document.getElementById('{{ editorId|e('js') }}');

        const enforceButtonTypes = () => {
            if (!editorRoot) {
                return;
            }

            editorRoot.querySelectorAll('button:not([type])').forEach((button) => {
                button.type = 'button';
            });
        };

        const syncHiddenValue = (editorInstance) => {
            hidden.value = editorInstance.json;
        };

        const editor = new JSONEditor({
            id: "{{ editorId|e('js') }}",
            json: (jsonData && typeof jsonData === 'object') ? jsonData : {},
            when: {
                rendered: () => {
                    enforceButtonTypes();
                    syncHiddenValue(editor);
                },
                updated: ()  => {
                    enforceButtonTypes();
                    syncHiddenValue(editor);
                }
            }
        });

        enforceButtonTypes();
        syncHiddenValue(editor);
    });
</script>
